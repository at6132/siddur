{
  "expo": {
    "name": "Siddur",
    "slug": "siddur",
    "scheme": "siddur",
    "version": "1.8.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.siddur.app",
      "buildNumber": "22",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Siddur uses your location while you use the app to calculate zmanim, schedule sunset-based reminders, and point Mizrach toward Jerusalem. Location stays on your device.",
        "NSUserNotificationsUsageDescription": "We'll send reminders for davening, zmanim, and the features you turn on.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/shabbos-alarm.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Siddur uses your location while you use the app to calculate zmanim, schedule sunset-based reminders, and point Mizrach toward Jerusalem. Location stays on your device."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F7",
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "44bb4af8-f301-486a-9a3a-d43ea10755dc"
      },
      "analyticsUrl": "https://analytics-api-production-cb55.up.railway.app",
      "legal": {
        "privacyUrl": "https://www.siddur24seven.com/privacy",
        "termsUrl": "https://www.siddur24seven.com/terms",
        "supportUrl": "https://www.siddur24seven.com/support",
        "supportPhone": "347-554-7549",
        "supportEmail": "shevastudios@gmail.com"
      }
    },
    "owner": "avitaub",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/44bb4af8-f301-486a-9a3a-d43ea10755dc"
    },
    "android": {
      "versionCode": 22,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    }
  }
}
